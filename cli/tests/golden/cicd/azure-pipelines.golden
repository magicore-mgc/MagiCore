# Generated by `mgc ci-generate`. Regenerate instead of editing by hand.
# Sinh bởi `mgc ci-generate`. Hãy sinh lại thay vì sửa tay.
trigger:
  - main

pool:
  vmImage: ubuntu-latest

steps:
  - bash: |
      set -eu
      pin_dir="$(mktemp -d)"
      trap 'rm -rf "$pin_dir"' EXIT
      installer="$pin_dir/install-from-gh.sh"
      curl -fsSL "https://raw.githubusercontent.com/mingd-153/MagiCore/51acbbb942d48407af82f5282fed0ffd5038516d/scripts/install-from-gh.sh" -o "$installer"
      if curl -fsSL "https://raw.githubusercontent.com/mingd-153/MagiCore/51acbbb942d48407af82f5282fed0ffd5038516d/scripts/install-from-gh.sh.sha256" -o "$pin_dir/install-from-gh.sh.sha256"; then
        (cd "$pin_dir" && { sha256sum -c install-from-gh.sh.sha256 || shasum -a 256 -c install-from-gh.sh.sha256; })
      else
        echo "WARNING: no .sha256 checksum file published next to the installer — companion verification skipped"
      fi
      if [ -n "903f620f989e0314007ed8258523c42a39d05c3dfadba8b49bb91603b45bb9db" ]; then
        echo "903f620f989e0314007ed8258523c42a39d05c3dfadba8b49bb91603b45bb9db  $installer" | { sha256sum -c - || shasum -a 256 -c -; }
      else
        echo "WARNING: installer integrity NOT pinned (MGC_INSTALLER_SHA256 empty) — trusting commit SHA 51acbbb942d48407af82f5282fed0ffd5038516d only"
      fi
      bash "$installer" --version v1.2.0
      mgc --version
    displayName: Setup MagiCore v1.2.0

  - bash: mgc install
    displayName: Install

  - bash: MGC_AUDIT_STRICT=1 mgc verify
    displayName: Verify
